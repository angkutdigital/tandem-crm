{
  "name": "tandem-crm",
  "version": "0.2.1",
  "description": "Partner commissions with holds, approvals, disputes and a replayable audit trail, in your own Postgres. An embeddable, event-sourced CRM engine for Node. MIT.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tandem-crm": "bin/tandem-crm.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "db/migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-money-actions.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angkutdigital/tandem-crm.git"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "crm",
    "commission",
    "commissions",
    "affiliate",
    "partner",
    "referral",
    "recurring-commission",
    "event-sourcing",
    "row-level-security",
    "embeddable",
    "typescript"
  ],
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "homepage": "https://tandemcrm.dev",
  "bugs": {
    "url": "https://github.com/angkutdigital/tandem-crm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
